            <Component class="javax.swing.JTextArea" name="jTextArea2">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Helvetica Neue" size="18" style="0"/>
                </Property>
                <Property name="lineWrap" type="boolean" value="true"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="DinkSphere is a pickleball court booking and scheduling system designed to make the process of reserving, and managing court sessions easier and more convenient. It   provides  players   with  a  simple   way  to  explore  available   courts,  check schedules, and plan their games without the hassle of manual reservations.&#xa;&#xa;With DinkSphere,   players  can  quickly find  the  court that  fits  their  needs,  view  important court information, and manage their  reservations  in one    convenient    platform. The system is designed with a  clean  and  user-friendly  interface so that both new and experienced players can easily navigate and enjoy the experience.&#xa;&#xa;Whether you&apos;re playing casually with friends or preparing for your next competitive match, DinkSphere helps make every game easier to plan and more enjoyable."/>
                <Property name="autoscrolls" type="boolean" value="false"/>
                <Property name="caretColor" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color blue="cc" green="ff" red="0" type="rgb"/>
                </Property>
                <Property name="disabledTextColor" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color blue="0" green="0" red="0" type="rgb"/>
                </Property>
              </Properties>
            </Component>
          </SubComponents>
